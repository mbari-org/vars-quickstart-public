set -e

# -- GLOBAL VARIABLES
# Base directory of the script
BASE_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Script Name (renamed from PROG to SCRIPT_NAME for consistency)
SCRIPT_NAME=$(basename "$0")

# docker directory
DOCKER_DIR="$BASE_DIR/docker"

# Path to the etc/env directory
ETC_ENV_DIR="$BASE_DIR/etc/env"

# Path to the env file. 
ENV_FILE="$DOCKER_DIR/env.sh"

# Path to the core env file
CORE_ENV_FILE="$BASE_DIR/etc/env/core.env.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored message
print_info() {
    echo -e "${BLUE}[INFO] ${NC} $1"
}

print_success() {
    echo -e "${GREEN}[OK]   ${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARN]  ${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# -- HELPER FUNCTIONS
_help() {
    cat << EOF
VARS Quickstart (varsq) - Docker orchestration for VARS services and databases

Usage: $SCRIPT_NAME <target> <subcommand> [options]

Commands:
    backup    Backup the postgres database (timestamped pg_dumpall)
    build     Build the docker containers
    configure Set environment variables for the target
    docker    Run docker compose commands (pass through)
    env       Show environment variables for the target
    mkcert    Generate self-signed SSL certificate and key
    resolved  Show resolved environment variables (evaluated values)
    restore   Restore the postgres database from the most recent backup
    run       Run a python or scala script
    scripts   List available python and scala scripts
    start     Start the docker containers
    stop      Stop the docker containers
    status    Show the status of the docker containers
    targets   List available targets enviroments
    update    Update the docker images
    upgrade   Upgrade postgres to the major version pinned in docker/compose.yml (experimental)

Examples:
    $(basename "$0") targets
    $(basename "$0") configure localhost
    $(basename "$0") mkcert
    $(basename "$0") start
    $(basename "$0") docker ps

EOF
}

# Load environment
load_env() {
    if [[ ! -f "$ENV_FILE" ]]; then
        print_error "No environment configured. Run: $(basename "$0") configure <target>"
        exit 1
    fi

    set -a
    source "$ENV_FILE"
    set +a
}


_backup() {
    # Backup all postgres databases to a timestamped file from the backup directory.
    load_env

    local backup_dir="/var/lib/postgresql/data/backup"
    local timestamp
    timestamp=$(date +%Y%m%dT%H%M%SZ)
    local backup_file="${backup_dir}/backup_${timestamp}.sql"

    print_info "Creating backup directory inside postgres container..."
    (cd "$DOCKER_DIR" && docker compose exec --user postgres -T postgres \
        bash -c "mkdir -p '${backup_dir}'")

    print_info "Dumping all databases to ${backup_file}..."
    (cd "$DOCKER_DIR" && docker compose exec --user postgres -T postgres \
        bash -c "pg_dumpall --clean --if-exists > '${backup_file}'")

    print_success "Backup complete: ${backup_file}"
}

_restore() {
    # Restore the postgres database from the most recent backup file in the backup directory.
    load_env

    local backup_dir="/var/lib/postgresql/data/backup"

    print_info "Searching for most recent backup in ${backup_dir}..."
    local most_recent
    most_recent=$(cd "$DOCKER_DIR" && docker compose exec -T postgres \
        bash -c "ls -t ${backup_dir}/*.sql 2>/dev/null | head -1" 2>/dev/null) || true
    most_recent=$(echo "$most_recent" | tr -d '[:space:]')

    if [ -z "$most_recent" ]; then
        print_error "No backup files found in ${backup_dir}. Run '$(basename "$0") backup' first."
        exit 1
    fi

    print_info "Most recent backup: ${most_recent}"
    print_info "Creating safety backup of current state before restore..."
    _backup

    print_info "Stopping all services for restore..."
    (cd "$DOCKER_DIR" && docker compose down)

    print_info "Starting postgres for restore..."
    (cd "$DOCKER_DIR" && docker compose up -d postgres)

    print_info "Waiting for postgres to be ready..."
    local retries=30
    while ! (cd "$DOCKER_DIR" && docker compose exec -T postgres pg_isready -U "$POSTGRES_USER") 2>/dev/null; do
        retries=$((retries - 1))
        if [ $retries -le 0 ]; then
            print_error "Postgres did not become ready in time. Aborting restore."
            exit 1
        fi
        sleep 1
    done

    print_info "Restoring from ${most_recent}..."
    (cd "$DOCKER_DIR" && docker compose exec --user postgres -T postgres \
        psql -f "${most_recent}" postgres)

    print_success "Database restored from $(basename "${most_recent}")"

    print_info "Restarting all services..."
    (cd "$DOCKER_DIR" && docker compose up -d)

    print_success "Restore complete. All services are running."
}

_upgrade() {
    # Experimental: Upgrade postgres to the major version pinned in docker/compose.yml. 
    # This is a destructive operation that will create a new pgdata directory and restore 
    # from the most recent backup. The old pgdata directory will be archived with a timestamp
    # for safety, but should be removed once the upgrade is verified.
    load_env

    # --- Detect current major version from the PG_VERSION file in pgdata ---
    local pg_version_file="${POSTGRES_DIR}/pgdata/PG_VERSION"
    if [ ! -f "$pg_version_file" ]; then
        print_error "No postgres data directory found at ${POSTGRES_DIR}/pgdata"
        print_info  "Has postgres been initialized? Try: $(basename "$0") start"
        exit 1
    fi
    local current_major
    current_major=$(tr -d '[:space:]' < "$pg_version_file")

    # --- Detect target major version from compose.yml image tag ---
    local target_tag
    target_tag=$(grep 'image: postgres:' "$DOCKER_DIR/compose.yml" \
        | awk -F: '{print $NF}' | tr -d '[:space:]')
    local target_major
    target_major=$(echo "$target_tag" | cut -d. -f1)

    print_info "Running postgres major version: ${current_major}"
    print_info "Target  postgres major version: ${target_major}"

    if [ "$target_major" -lt "$current_major" ]; then
        print_error "Downgrading postgres (${current_major} → ${target_major}) is not supported."
        print_info  "Update the image tag in docker/compose.yml to a newer major version."
        exit 1
    fi

    if [ "$current_major" -eq "$target_major" ]; then
        print_warning "Already on major version ${current_major}. No major upgrade needed."
        print_info   "For a minor version update: $(basename "$0") docker pull postgres && $(basename "$0") docker restart postgres"
        exit 0
    fi

    print_info "Major version upgrade: ${current_major} → ${target_major}"

    # --- Step 1: Backup current state ---
    print_info "Backing up current database before upgrade..."
    _backup

    # --- Step 2: Pull the new image ---
    print_info "Pulling postgres:${target_tag}..."
    (cd "$DOCKER_DIR" && docker compose pull postgres)

    # --- Step 3: Stop all services ---
    print_info "Stopping all services..."
    (cd "$DOCKER_DIR" && docker compose down)

    # --- Step 4: Archive old pgdata only (backup/ dir stays in place under POSTGRES_DIR) ---
    local pgdata_dir="${POSTGRES_DIR}/pgdata"
    local archive_name="pgdata_pre_upgrade_${current_major}_$(date +%Y%m%dT%H%M%SZ)"
    local archive_dir="${POSTGRES_DIR}/${archive_name}"
    print_info "Archiving old data directory to ${archive_name}..."
    mv "$pgdata_dir" "$archive_dir"

    # --- Step 5: Start fresh postgres (triggers initdb on empty pgdata) ---
    print_info "Starting fresh postgres ${target_major} instance..."
    (cd "$DOCKER_DIR" && docker compose up -d postgres)

    # --- Step 6: Wait for postgres to be ready ---
    print_info "Waiting for postgres to be ready..."
    local retries=60
    while ! (cd "$DOCKER_DIR" && docker compose exec -T postgres \
            pg_isready -U "$POSTGRES_USER") 2>/dev/null; do
        retries=$((retries - 1))
        if [ $retries -le 0 ]; then
            print_error "Postgres did not become ready. Old data preserved at: ${archive_dir}"
            exit 1
        fi
        sleep 1
    done

    # --- Step 7: Restore from the most recent backup (still mounted at backup/ in the new container) ---
    local backup_dir="/var/lib/postgresql/data/backup"
    local most_recent
    most_recent=$(cd "$DOCKER_DIR" && docker compose exec -T postgres \
        bash -c "ls -t ${backup_dir}/*.sql 2>/dev/null | head -1" 2>/dev/null) || true
    most_recent=$(echo "$most_recent" | tr -d '[:space:]')

    print_info "Restoring data from $(basename "${most_recent}")..."
    (cd "$DOCKER_DIR" && docker compose exec --user postgres -T postgres \
        psql -f "${most_recent}" postgres)

    print_success "Database upgraded and restored from $(basename "${most_recent}")"
    print_info   "Old data directory preserved at: ${archive_dir}"
    print_info   "Once the upgrade is verified, remove it with: rm -rf '${archive_dir}'"

    # --- Step 8: Start all services ---
    print_info "Starting all services..."
    (cd "$DOCKER_DIR" && docker compose up -d)

    print_success "Upgrade complete: postgres ${current_major} → ${target_major}. All services are running."
}

_build() {
    # Build the docker containers. This is not often used except in development or when rebuilding
    # after an upgrade. By default, 'docker compose up' will pull the latest images and only rebuild
    # if there are changes to the Dockerfiles or build context, so manual builds are not usually necessary.
    load_env

    # We've include pythia, a machine learning microservice for generating annotations from images. 
    # It requires a model file to be present in PYTHIA_MODEL_DIR with the name specified by PYTHIA_MODEL_NAME.
    # If none is found, we'll fetch the FathomNet megalodon model from Hugging Face and save it to that location.
    local model_path="${PYTHIA_MODEL_DIR}/${PYTHIA_MODEL_NAME}"
    if [ ! -f "$model_path" ]; then
        print_warning "ML model not found at ${model_path}"
        print_info "Fetching model from Hugging Face..."
        echo $PYTHIA_MODEL_DIR
        mkdir -p "$PYTHIA_MODEL_DIR"
        curl -L --progress-bar \
            "https://huggingface.co/spaces/FathomNet/megalodon/resolve/main/best.pt" \
            -o "$model_path"
        print_success "Model saved to ${model_path}"
    else
        print_info "ML model found at ${model_path}"
    fi

    echo "Building service using docker compose..."
    _docker build "$@"
}

_configure() {
    # Configure environment variables for the specified target. This creates the env file that 
    # is used for docker compose and other commands.

    local target="$1"

    if [[ -z "$target" ]]; then
        print_error "No target specified"
        echo ""
        list_targets
        exit 1
    fi

    local source_file="${ETC_ENV_DIR}/${target}.env"

    if [[ ! -f "$source_file" ]]; then
        print_error "Target file not found: $source_file"
        echo ""
        list_targets
        exit 1
    fi

    if [[ ! -f "$CORE_ENV_FILE" ]]; then
        print_error "Core file not found: $CORE_ENV_FILE"
        exit 1
    fi

    print_info "Configuring environment for target: $target"

    # Merge: source file first, then core (core wins due to later exports)
    cat "$source_file" > "$ENV_FILE"
    echo "" >> "$ENV_FILE" # Add a newline for readability
    echo "# --- Core overrides (from core.env.sh) ---" >> "$ENV_FILE"
    cat "$CORE_ENV_FILE" >> "$ENV_FILE"

    print_success "Environment configured: $ENV_FILE"
}

_docker() {
    # Run docker compose commands in the docker directory, ensuring the environment is loaded first.

    load_env   
    if [ ! -d "$DOCKER_DIR" ]; then
        print_error "Docker directory not found at '$DOCKER_DIR'." >&2
        return 1
    fi

    # TODO: Check that SSL certificates exist if needed

    print_info "Executing 'docker compose $*' inside $DOCKER_DIR/"
    # Run docker compose in a subshell, passing all arguments provided to _docker
    (cd "$DOCKER_DIR" && docker compose "$@")
}

_env() {
    # Show the contents of the env file for the current target. This is useful for debugging and verification.
    echo "--- Contents of $ENV_FILE ---"
    if [ -f "$ENV_FILE" ]; then
        cat "$ENV_FILE"
    else
        print_error "$ENV_FILE not found. Run the 'configure' command first." >&2
        return 1
    fi
    echo "--------------------------------"
}


_mkcert() {
    # Generate self-signed SSL certificate and key for localhost testing. This is used by the 
    # Nginx container to serve the VARS/M3 microservices over HTTPS. The certificate will be 
    # generated for "localhost" and "*.localhost". If mkcert is installed, it will be used to 
    # generate a local CA and trusted certificate. Make sure to run `mkcert --install`.

    load_env

    local cert_path="${BASE_DIR}/temp/ssl/server.crt"
    local key_path="${BASE_DIR}/temp/ssl/server.key"
    mkdir -p "$(dirname "$cert_path")"

    # if mkcert is installed, use it
    if command -v mkcert >/dev/null 2>&1; then
        print_info "mkcert found. Generating local CA and self-signed certificate..."
        # mkcert -install
        mkcert -cert-file "$cert_path" -key-file "$key_path" "localhost" "*.localhost" "127.0.0.1" "::1" "$VARS_WEB_SERVER"
        
        return
    fi
    # Fallback to openssl if mkcert is not available
    print_warning "mkcert not found. Falling back to openssl..."

    print_info "Generating self-signed SSL certificate at '$cert_path' and key at '$key_path'..."

    # Determine if VARS_WEB_SERVER is an IP address or a hostname
    local san_entry
    if [[ "$VARS_WEB_SERVER" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || [[ "$VARS_WEB_SERVER" =~ : ]]; then
        san_entry="IP:${VARS_WEB_SERVER}"
    else
        san_entry="DNS:${VARS_WEB_SERVER}"
    fi

    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout "$key_path" \
        -out "$cert_path" \
        -subj "/C=US/ST=California/L=Monterey/O=MBARI/OU=IT/CN=localhost" \
        -addext "subjectAltName=DNS:localhost,DNS:*.local,${san_entry},IP:127.0.0.1"

    print_success "Self-signed SSL certificate and key generated successfully."
}

_resolved() {
    # Show resolved environment variables with their evaluated values. This is useful for debugging 
    # and verification. 
    load_env
    print_info "Resolved environment variables from $ENV_FILE"
    echo "# ------------------------------------------------------"
    # Source the env file in a subshell and print all exported variables with their resolved values
    (
        # shellcheck source=/dev/null
        source "$ENV_FILE"
        # Use env to get all environment variables, filter for those starting with common prefixes
        # Sort for easier reading
        env | grep -E '^(ANNOSAURUS_|BEHOLDER_|CHARYBDIS_|ONI_|PANOPTES_|RAZIEL_|SKIMMER_|VAMPIRESQUID_|VAMPIRE_SQUID_|VARS_|M3_|LOGBACK_|BASICJWT_|DATABASE_|MESSAGING_|HTTP_|AUTHENTICATION_|IMAGE_|JWT_|MAC_|NGINX_|FRAMEGRABS_|MEDIA_|SSL_|SQLSERVER_)' | sort
    )
    echo "# ------------------------------------------------------"
}

_run() {
    # Run a python or scala script from the etc/python or etc/scala directories, respectively. 
    # The script should be passed as the first argument, and any additional arguments will be 
    # forwarded to the script. This is useful for running ad-hoc scripts that interact with the 
    # VARS/M3 services or databases, without needing to enter a container or set up a separate 
    # environment. The environment variables will be loaded before running the script, so they 
    # can be used for configuration.
    load_env

    local script_name=$(basename -- "$1")
    local script_ext="${script_name##*.}"

    if [ "$script_ext" = "py" ]; then
        python "$BASE_DIR/etc/python/$1" "${@:2}"
        return
    elif [ "$script_ext" = "sc" ]; then
        export VARS_PWD="$VARS_KB_DATABASE_PASSWORD"
        "$BASE_DIR/etc/scala/$1" "${@:2}"
        return
    else
        print_error "Unsupported script type: .$script_ext (expected .py or .sc)"
        return 1
    fi

}

_scripts() {
    # List available python and scala scripts in the etc/python and etc/scala directories, respectively.
    local python_dir="$BASE_DIR/etc/python"
    local scala_dir="$BASE_DIR/etc/scala"
    local found=0

    print_info "Available scripts for './varsq run <script>':"
    echo ""

    # List Python scripts
    if [ -d "$python_dir" ]; then
        local py_scripts
        py_scripts=$(find "$python_dir" -maxdepth 1 -name "*.py" -type f 2>/dev/null | sort)
        if [ -n "$py_scripts" ]; then
            print_info "Python scripts (etc/python/):"
            while IFS= read -r script; do
                echo "  -  $(basename "$script")"
            done <<< "$py_scripts"
            echo ""
            found=1
        fi
    fi

    # List Scala scripts
    if [ -d "$scala_dir" ]; then
        local sc_scripts
        sc_scripts=$(find "$scala_dir" -maxdepth 1 -name "*.sc" -type f 2>/dev/null | sort)
        if [ -n "$sc_scripts" ]; then
            print_info "Scala scripts (etc/scala/):"
            while IFS= read -r script; do
                echo "  -  $(basename "$script")"
            done <<< "$sc_scripts"
            echo ""
            found=1
        fi
    fi

    if [ $found -eq 0 ]; then
        print_warning "No scripts found."
        print_info "  Python scripts should be placed in: $python_dir"
        print_info "  Scala scripts should be placed in: $scala_dir"
    fi
}

_start() {
    # Start the docker containers using docker compose. This will start all services defined in 
    # the compose.yml file. The environment variables will be loaded before starting, so they 
    # can be used for configuration.
    load_env
    print_info "Starting service using docker compose..."
    print_info "    Using environment file at $ENV_FILE"
    print_info "    Using temp dir at $M3_TEMP_DIR"
    print_info "    Ensuring SSL certificate and key exist at ${SSL_CERT_FILE} and ${SSL_KEY_FILE}..."
    if [ ! -f "${SSL_CERT_FILE}" ] || [ ! -f "${SSL_KEY_FILE}" ]; then
        print_error "SSL certificate or key not found. Run 'varsq mkcert' to generate self-signed certificate and key for localhost testing."
        exit 1
    fi
    _docker up -d "$@"
}

_stop() {
    # Stop the docker containers using docker compose. 
    load_env
    print_info "Stopping service using docker compose..."
    _docker down "$@"
}

_status() {
    # Show the status of the docker containers using docker compose. This is a wrapper around 
    #'docker compose ps' that ensures the environment is loaded first.
    load_env
    print_info "Checking status..."
    _docker ps "$@"
}

_targets() {
    # List available environment targets
    print_info "Available environment targets:"
    echo ""
    for f in "${ETC_ENV_DIR}"/*.env; do
        if [[ -f "$f" ]]; then
            target=$(basename "$f" .env)
            echo "  - $target"
        fi
    done
    echo ""
    print_info "Configure with: $(basename "$0") configure <target>"
}

_update() {
    # Update the docker images for all services. This is a wrapper around 'docker compose pull'.
    print_info "Updating docker images..."
    # The original script just echoed, but this actually runs the pulls
    docker pull mbari/annosaurus
    docker pull mbari/beholder
    docker pull mbari/charybdis
    docker pull mbari/oni
    docker pull mbari/panoptes
    docker pull mbari/pythia-python
    docker pull mbari/raziel
    docker pull mbari/skimmer
    docker pull mbari/vampire-squid
    docker pull nginx:latest
    docker pull prom/prometheus
}

# Main logic
# Check if the first argument is empty or a help flag
if [[ -z "$1" ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    _help
    exit 0
fi

# Store the subcommand and shift arguments to the left
SUBCOMMAND=$1
shift

# Case statement to handle subcommands
case "$SUBCOMMAND" in
    backup)
        _backup "$@"
        ;;
    build)
        _build "$@"
        ;;
    configure)
        _configure "$@"
        ;;
    docker)
        _docker "$@"
        ;;
    env)
        _env "$@"
        ;;
    mkcert)
        _mkcert "$@"
        ;;
    resolved)
        _resolved "$@"
        ;;
    restore)
        _restore "$@"
        ;;
    run)
        _run "$@"
        ;;
    scripts)
        _scripts "$@"
        ;;
    start)
        _start "$@"
        ;;
    stop)
        _stop "$@"
        ;;
    status)
        _status "$@"
        ;;
    targets)
        _targets "$@"
        ;;
    update)
        _update "$@"
        ;;
    upgrade)
        _upgrade "$@"
        ;;
    *)
        echo "Error: Unknown subcommand '$SUBCOMMAND'" >&2
        _help
        exit 1
        ;;
esac
